#!/usr/bin/env sh
. "$(dirname -- "$0")/_/husky.sh"

echo "🔨 Running Next.js build before push..."
echo "This ensures only deployable code reaches the repository."
echo ""

npm run build

if [ $? -ne 0 ]; then
  echo ""
  echo "❌ BUILD FAILED!"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo "Your push has been blocked because the build failed."
  echo "Please fix the build errors before pushing."
  echo ""
  echo "To bypass this check (not recommended):"
  echo "  git push --no-verify"
  echo "━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━"
  echo ""
  exit 1
fi

echo ""
echo "✅ Build successful! Proceeding with push..."
echo ""
